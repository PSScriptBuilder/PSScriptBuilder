        [PSScriptBuilderBumpType] $bumpType,
        [bool]   $updateBuildDetails, 
        [bool]   $updateGitDetails, 
        [string] $prerelease, 
        [string] $buildMetadata,
        [bool]   $clearPrerelease,
        [bool]   $clearBuildMetadata,
        [string] $version
    ) {
